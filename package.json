{
  "name": "@orygn/discord-mcp",
  "version": "2.0.0",
  "description": "Discord server management MCP for AI agents: chat, moderation, admin, and full server building. Formerly Omnicord.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Orygn LLC",
  "homepage": "https://github.com/OrygnsCode/discord-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrygnsCode/discord-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/OrygnsCode/discord-mcp/issues"
  },
  "keywords": [
    "discord",
    "discord-mcp",
    "mcp-discord",
    "discord-mcp-server",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "discord-bot",
    "discord-server",
    "moderation",
    "server-builder",
    "ai",
    "claude",
    "omnicord"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "orygn-discord-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke-modern.mjs && node scripts/smoke-dialog.mjs && node scripts/smoke-http.mjs",
    "test": "npm run build && node scripts/unit.mjs && node scripts/smoke.mjs && node scripts/smoke-modern.mjs && node scripts/smoke-dialog.mjs && node scripts/smoke-http.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@discordjs/ws": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "discord-api-types": "^0.38.58",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^6.29.1"
  },
  "mcpName": "io.github.OrygnsCode/discord-mcp"
}
